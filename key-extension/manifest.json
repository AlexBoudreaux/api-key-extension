{
  "manifest_version": 3,
  "name": "API Key Garage",
  "version": "1.0",
  "description": "Securely store and manage your API keys",
  "permissions": [
    "storage",
    "tabs",
    "clipboardWrite",
    "unlimitedStorage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "128": "icon128.png"
  }
}